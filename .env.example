# =============================================================================
# PatronFlow Environment Variables
# =============================================================================

# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL (for auth redirects)
# In production, set this to your actual domain (e.g., https://patronflow.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# Payment Providers (configure for production billing)
# =============================================================================

# Stripe (International payments)
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_ID=price_...

# Razorpay (Indian payments)
# Get these from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...
RAZORPAY_PLAN_ID=plan_...
# Same as RAZORPAY_KEY_ID — used if client-side checkout is needed later
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...

# PayPal (Alternative international payments)
# Get these from: https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=...
PAYPAL_CLIENT_SECRET=...
PAYPAL_WEBHOOK_ID=...
PAYPAL_PLAN_ID=P-...

# =============================================================================
# Rate Limiting (optional - uses in-memory store if not configured)
# =============================================================================

# Upstash Redis (recommended for production)
# Get these from: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...
